import torch
import torch.nn as nn

class HopfCPGNetwork(nn.Module):
    def __init__(self, num_envs:int, device:str= "cuda:0"):
        super().__init__()
        self.num_envs = num_envs
        self.device = device

        # Base Oscillator Parameters
        self.alpha = 1.0
        self.beta = 1.0
        self.mu = 1.0
        self.b = 1.0
        self.coupling_lambda = 0.4137

        # Gait Presets (Phase Offsets phi_i relative to leg 0)
        # Legs: [L1, L2, L3, R1, R2, R3] mapped to indices [0, 1, 2, 3, 4, 5]
        self.gait_phases = {
            "tripod": torch.tensor([0.0, torch.pi, 0.0, torch.pi, 0.0, torch.pi], device=device),
            "quadruped": torch.tensor([0.0, 2*torch.pi/3, 4*torch.pi/3, 2*torch.pi/3, 4*torch.pi/3, 0.0], device=device),
            "wave": torch.tensor([0.0, 2*torch.pi/6, 4*torch.pi/6, 1*torch.pi/6, 3*torch.pi/6, 5*torch.pi/6], device=device)
        }

        # Initialize States [num_envs, num_legs=6]
        self.x = torch.zeros((num_envs, 6), dtype=torch.float32, device=device)
        self.y = torch.zeros((num_envs, 6), dtype=torch.float32, device=device)
        self.set_gait("tripod", duty_factor=0.5, omega_swing=2.0 * torch.pi * 1.5)

    def set_gait(self, gait_name:str, duty_factor:float, omega_swing:float):
        self.duty_factor = duty_factor
        self.omega_swing = omega_swing
        self.omega_stance = ((1.0 - duty_factor) / duty_factor) * omega_swing

        phases = self.gait_phases[gait_name]
        # Target phase difference matrix: theta_ji = phi_i - phi_j [6, 6]
        self.theta = phases.unsqueeze(1) - phases.unsqueeze(0)

        # Non-zero initial conditions to seed limit cycle
        self.x = 0.1 * torch.cos(phases).repeat(self.num_envs, 1)
        self.y = 0.1 * torch.sin(phases).repeat(self.num_envs, 1)

    def dynamics(self, x:torch.Tensor, y:torch.Tensor):
        # r^2 = x^2 + y^2 [num_envs, 6]
        r2 = x**2 + y**2

        # Smooth frequency switching based on y
        # y > 0 -> swing; y <= 0 -> stance
        sigma_swing = 1.0 / (1.0 + torch.exp(torch.clamp(self.b * y, -15.0, 15.0)))
        sigma_stance = 1.0 / (1.0 + torch.exp(torch.clamp(-self.b * y, -15.0, 15.0)))
        omega = self.omega_stance * sigma_stance + self.omega_swing * sigma_swing

        # Coupling term: sum_j (y_j * cos(theta_ji) - x_j * sin(theta_ji))
        # Tensor broadcasting: [num_envs, 1, 6] x [1, 6, 6] -> [num_envs, 6]
        cos_t = torch.cos(self.theta).unsqueeze(0)
        sin_t = torch.sin(self.theta).unsqueeze(0)
        x_j = x.unsqueeze(1)  # shape: [num_envs, 1, 6]
        y_j = y.unsqueeze(1)

        coupling = torch.sum(y_j * cos_t - x_j * sin_t, dim=2)

        # State equations
        dx = self.alpha * (self.mu - r2) * x - omega * y
        dy = self.beta * (self.mu - r2) * y + omega * x + self.coupling_lambda * coupling

        return dx, dy

    def step(self, dt: float):
        # 4th-Order Runge-Kutta step
        k1_x, k1_y = self._dynamics(self.x, self.y)
        k2_x, k2_y = self._dynamics(self.x + 0.5 * dt * k1_x, self.y + 0.5 * dt * k1_y)
        k3_x, k3_y = self._dynamics(self.x + 0.5 * dt * k2_x, self.y + 0.5 * dt * k2_y)
        k4_x, k4_y = self._dynamics(self.x + dt * k3_x, self.y + dt * k3_y)

        self.x += (dt / 6.0) * (k1_x + 2.0 * k2_x + 2.0 * k3_x + k4_x)
        self.y += (dt / 6.0) * (k1_y + 2.0 * k2_y + 2.0 * k3_y + k4_y)

        # Output normalized outputs and phase state flags
        is_swing = (self.y > 0.0)
        return self.x, self.y, is_swing